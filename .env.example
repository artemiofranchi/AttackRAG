# =============================================================================
# ЗАФИКСИРОВАННЫЙ ПРОФИЛЬ (текущая постановка эксперимента)
# =============================================================================
#
# ┌─────────────────────────────────────┬────────────────────────────────────┐
# │ Компонент                           │ Что используется                   │
# ├─────────────────────────────────────┼────────────────────────────────────┤
# │ Генерация ответа RAG (LLM)          │ Llama через Ollama                 │
# │ Векторизация корпуса / запроса      │ Sentence-Transformers (индекс)     │
# │ RAGAS: судья (LLM)                  │ Gemini                             │
# │ RAGAS: эмбеддинги для метрик        │ Gemini                             │
# └─────────────────────────────────────┴────────────────────────────────────┘
#
# Индекс: модель задаётся при сборке (по умолчанию
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2):
#   attack-rag-build-index
#   или: attack-rag-build-index --embedding-model ...
#
# Пока этот профиль задан явно; позже можно менять LLM_PROVIDER / RAGAS_JUDGE.

# --- Генерация (Llama / Ollama)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://127.0.0.1:11434

# --- Retrieval / reranking (опционально)
# RAG_TOP_K=10
# RAG_CANDIDATE_K=20
# RAG_RERANKER_ENABLED=true
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RAG_RERANKER_BATCH_SIZE=16

# --- RAGAS: только Gemini (LLM судья + эмбеддинги судьи)
RAGAS_JUDGE=gemini
GEMINI_API_KEY=
# Модели именно для оценки RAGAS (не путать с генератором)
RAGAS_GEMINI_MODEL=gemini-2.0-flash
RAGAS_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Таймауты RAGAS (на строку × метрику по умолчанию 180 с в библиотеке — мало для Gemini)
# RAGAS_TIMEOUT_SEC=600
# RAGAS_MAX_WORKERS=4
# HTTP-клиент судьи (секунды на один запрос)
# RAGAS_HTTP_TIMEOUT=300
# Число «гипотез» для answer_relevancy (3 = больше вызовов API; при таймаутах попробуйте 1)
# RAGAS_ANSWER_RELEVANCY_STRICTNESS=3
# Дубли для совместимости (если не задали RAGAS_*):
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GOOGLE_API_KEY=

# =============================================================================
# Другие режимы (закомментировано; включайте вместо блока выше)
# =============================================================================

# Генерация через Gemini:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Судья RAGAS через OpenAI:
# RAGAS_JUDGE=openai
# OPENAI_API_KEY=
# RAGAS_JUDGE_MODEL=gpt-4o
# RAGAS_EMBEDDING_MODEL=text-embedding-3-small

# Генерация OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Судья RAGAS целиком на Ollama (нужен ollama pull nomic-embed-text и чат-модель):
# LLM_PROVIDER=ollama
# RAGAS_JUDGE=ollama
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
